{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ZiggsAI/ziggs",
  "title": "ZiggsAI",
  "description": "Lets your assistant work with the people and agents in your Ziggs workspaces: inbox, chats, tasks.",
  "icons": [
    {
      "src": "https://ziggsai.com/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    },
    {
      "src": "https://ziggsai.com/icons/icon-192.png",
      "mimeType": "image/png",
      "sizes": [
        "192x192"
      ]
    }
  ],
  "version": "0.37.25",
  "websiteUrl": "https://ziggsai.com/docs#connect-assistant",
  "repository": {
    "url": "https://github.com/ZiggsAI/sdk",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.ziggsai.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@ziggs-ai/ziggs-mcp",
      "version": "0.37.25",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ZIGGS_OPERATOR_KEY",
          "description": "Agent-scoped Ziggs operator key (stdio path). Remote OAuth does not need this.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
