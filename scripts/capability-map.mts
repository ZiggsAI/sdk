import { readFile, writeFile } from 'node:fs/promises';
import { pathToFileURL } from 'node:url';
import { captureSurface } from '../ziggs-mcp/scripts/lib/capture-surface.mts';
import * as bundles from '../agent-sdk/src/platform/tools/index.js';
import { toolName, type ToolDefinition } from '../agent-sdk/src/tools/defineTool.js';
import { WAKE_TOOLS } from '../agent-sdk/src/platform/tools/tier1/wakeTools.js';

const configurations = {
  consent: { directConnection: false, coreOnly: false, debugTools: false },
  direct: { directConnection: true, coreOnly: false, debugTools: false },
  core: { directConnection: true, coreOnly: true, debugTools: false },
  debug: { directConnection: true, coreOnly: false, debugTools: true },
} as const;

export async function capabilityMap() {
  const surfaces = Object.fromEntries(await Promise.all(Object.entries(configurations)
    .map(async ([name, config]) => [name, await captureSurface(config)])));
  const sdkTools = [...new Set([
    ...Object.entries(bundles).filter(([name, tools]) => name.endsWith('_TOOLS') && Array.isArray(tools))
      .flatMap(([, tools]) => (tools as ToolDefinition[]).map(toolName)),
    ...WAKE_TOOLS.map(toolName),
  ].filter((name): name is string => typeof name === 'string'))].sort();
  return { surfaces, sdkTools };
}

export function renderCapabilityMap({ surfaces, sdkTools }: Awaited<ReturnType<typeof capabilityMap>>) {
  const names = Object.keys(configurations);
  const all = new Map(Object.values(surfaces).flatMap(({ tools, catalog }) => [...catalog, ...tools]).map((tool) => [tool.name, tool]));
  const escape = (value: string) => value.replaceAll('|', '\\|').replaceAll('\n', ' ');
  const lines = [
    '# Agent capability map', '',
    'Generated by `npm run map:capability`; verified by `npm run check:capability-map` in CI.',
    'MCP facts come from the real server factory, an in-memory `tools/list` connection, and its registered catalog. SDK names come from the exported platform tool bundles. No tool is executed and no backend connection is made.', '',
    'This describes this checkout. A deployed package or a connector with cached declarations can differ. Run `npm run map:capability -- --json` to export full schemas for comparison with that connector.', '',
    '## Registered surfaces', '',
    '| Configuration | Native tools | Catalog only | Total |',
    '|---|---:|---:|---:|',
  ];
  for (const name of names) {
    const { tools, catalog } = surfaces[name];
    const native = new Set(tools.map((t) => t.name));
    const extra = catalog.filter((t) => !native.has(t.name)).length;
    lines.push(`| ${name} | ${native.size} | ${extra} | ${native.size + extra} |`);
  }
  lines.push('', '`consent`: connected assistants; `direct`: configured operator keys; `core`: compact core tools; `debug`: internal tools enabled.', '',
    `MCP tools across all configurations: **${all.size}**. SDK platform tools across exported bundles: **${sdkTools.length}**.`, '',
    '## Tools', '', '`n` = native; `c` = catalog only; `-` = absent. SDK matches are names, not a claim that arguments or credentials are identical.', '',
    '| Tool | Title | consent | direct | core | debug | SDK name |',
    '|---|---|---|---|---|---|---|');
  for (const [name, tool] of [...all].sort(([a], [b]) => a.localeCompare(b))) {
    const states = names.map((key) => surfaces[key].tools.some((t) => t.name === name) ? 'n' : surfaces[key].catalog.some((t) => t.name === name) ? 'c' : '-');
    const sdk = name.replace(/^ziggs_/, '');
    lines.push(`| \`${name}\` | ${escape(tool.title ?? '')} | ${states.join(' | ')} | ${sdkTools.includes(sdk) ? `\`${sdk}\`` : '-'} |`);
  }
  const sdkOnly = sdkTools.filter((name) => !all.has(`ziggs_${name}`));
  lines.push('', '## SDK names without a matching MCP name', '', sdkOnly.map((name) => `- \`${name}\``).join('\n'), '',
    'HTTP routes are not part of this map. Product policy and migration guidance belong in the relevant tool documentation; they are not inferred from registration counts.', '');
  return lines.join('\n');
}

async function main() {
  const result = await capabilityMap();
  if (process.argv.includes('--json')) {
    console.log(JSON.stringify(result, null, 2));
    return;
  }
  const rendered = renderCapabilityMap(result);
  const target = new URL('../docs/capability-map.md', import.meta.url);
  if (process.argv.includes('--check')) {
    if (await readFile(target, 'utf8') !== rendered) {
      console.error('Capability map is stale. Run npm run map:capability and commit the result.');
      process.exitCode = 1;
    }
  } else await writeFile(target, rendered);
}
if (import.meta.url === pathToFileURL(process.argv[1] ?? '').href) await main();
