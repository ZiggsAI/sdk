{
  "name": "@ziggs-ai/agent-sdk",
  "version": "0.40.1",
  "description": "Agent framework SDK for building autonomous agents on the Ziggs platform",
  "homepage": "https://ziggsai.com/docs",
  "bugs": {
    "url": "https://ziggsai.com/support"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "rm -rf dist && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx/esm --test --test-reporter=spec test/*.test.ts",
    "test:watch": "node --experimental-test-module-mocks --import tsx/esm --test --watch test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@anthropic-ai/sdk": "^0.110.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ziggs-ai/api-client": "0.37.23",
    "@ziggs-ai/contracts": "^0.23.3",
    "ajv": "^8.17.1",
    "dotenv": "^17.2.3",
    "openai": "^4.0.0",
    "zod": "^4.0.0"
  },
  "keywords": [
    "ziggs",
    "agent",
    "sdk",
    "ai",
    "autonomous"
  ],
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZiggsAI/sdk.git",
    "directory": "agent-sdk"
  }
}
